# Copy this file to .env.delivery and replace every CHANGE_ME value.
# The real .env.delivery file is ignored by Git and must not be committed.

POSTGRES_DB=eventledger_delivery
POSTGRES_USER=eventledger_delivery
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

EVENTLEDGER_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_API_KEY
EVENTLEDGER_SOURCE_ID=delivery-example-source

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_DURATION_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=60
WORKER_SIMULATION_MAX_SLOW_SECONDS=30

# compose.delivery.yaml sets POSTGRES_HOST=db and POSTGRES_PORT=5432.
# It also forces WORKER_FAILURE_SIMULATION_ENABLED=false for the regular worker.
