# Virtual environments
.venv/
venv/
env/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environment files
.env
.env.*
!.env.example
!.env.test.example
!.env.delivery.example

# Test and coverage caches
.pytest_cache/
.coverage
htmlcov/

# ShipSafe local runtime state and credentials
shipsafe/runtime/
shipsafe/*.env
!shipsafe/runtime.env.example

# Terraform local cache, state, and variable files
**/.terraform/
!**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfplan.*
*.plan.txt
crash.log
*.tfvars
!*.tfvars.example

# Temporary AWS operator credential exports (never commit)
aws-credentials*.env
temporary-credentials*.json
**/.aws/


