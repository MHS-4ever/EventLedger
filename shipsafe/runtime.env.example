# Copy outside version control or to shipsafe/runtime.env (ignored by Git).
# Replace every CHANGE_ME value before running the ShipSafe controller.

POSTGRES_DB=eventledger_shipsafe
POSTGRES_USER=eventledger_shipsafe
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

EVENTLEDGER_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_API_KEY
EVENTLEDGER_SOURCE_ID=shipsafe-local

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_DURATION_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=60
WORKER_SIMULATION_MAX_SLOW_SECONDS=30

# The proxy is published only on host loopback.
SHIPSAFE_PROXY_PORT=8080
